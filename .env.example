# Copy to .env for local development. Never commit .env.
# The app must work with every value below left blank.

# AI assistant key (optional). Blank: the assistant quotes source passages directly.
FLAMEGUARD_AI_API_KEY=

# Model name for the assistant (optional; backend owner sets the default).
FLAMEGUARD_AI_MODEL=

# Local folder holding raw NASA downloads (outside git, or data/raw/).
FLAMEGUARD_RAW_DATA_DIR=

# Server
FLAMEGUARD_HOST=127.0.0.1
FLAMEGUARD_PORT=8000
