{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.schema.json",
  "title": "Error",
  "type": "object",
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "not_implemented",
            "not_found",
            "invalid_request",
            "unavailable"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
