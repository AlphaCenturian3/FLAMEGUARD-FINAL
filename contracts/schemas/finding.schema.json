{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Finding",
  "description": "One NASA-measured value or one FlameGuard-SI interpretation. Simulations are NOT Findings; they use SimulationResult only.",
  "type": "object",
  "required": [
    "id",
    "investigation_id",
    "evidence_class",
    "statement",
    "quantity",
    "value",
    "unit",
    "value_status",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "fixture": {
      "type": "boolean"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "investigation_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "evidence_class": {
      "$ref": "common.schema.json#/$defs/non_simulation_class"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": [
        "string",
        "null"
      ],
      "description": "Key from contracts/vocabulary.json, or null for a qualitative statement."
    },
    "value": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "value_status": {
      "$ref": "common.schema.json#/$defs/value_status"
    },
    "uncertainty": {
      "$ref": "common.schema.json#/$defs/text_or_null",
      "description": "Uncertainty exactly as reported by the source; never invented, and never a FlameGuard-SI assessment (those go in curation_notes)."
    },
    "conditions": {
      "$ref": "conditions.schema.json"
    },
    "fire_safety_topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "prevention",
          "detection",
          "suppression",
          "material_flammability",
          "ignition",
          "extinction",
          "other"
        ]
      }
    },
    "provenance": {
      "type": "object"
    },
    "relevant_environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/environment"
      },
      "description": "Interpretation findings only: crewed environments the interpretation is argued to apply to. A measured finding records where the experiment ran in conditions/platform instead."
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Interpretation findings only, and required there: assumptions, extrapolation limits and uncertainty of the interpretation. A measured finding uses the source-reported `uncertainty`."
    },
    "curation_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/curation_note"
      },
      "description": "Measured findings only. FlameGuard-SI cautions and exclusions, each attributed and, for exclusions, traced to a quality flag."
    },
    "test_id": {
      "$ref": "common.schema.json#/$defs/test_id"
    },
    "test_outcome": {
      "$ref": "common.schema.json#/$defs/test_outcome"
    }
  },
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/value_matches_status"
    },
    {
      "$ref": "quantity_rules.schema.json"
    },
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "measured"
          }
        }
      },
      "then": {
        "required": [
          "conditions"
        ],
        "properties": {
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manifest_id",
              "locator",
              "sources"
            ],
            "properties": {
              "manifest_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "description": "Where in the source: e.g. 'Table IX, row 3' or 'file.csv line 12'."
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "source.schema.json"
                }
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "relevant_environments"
              ]
            },
            {
              "required": [
                "limitations"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "interpretation"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "derived_from",
              "method",
              "method_version",
              "generated_by"
            ],
            "properties": {
              "derived_from": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "description": "Finding ids (measured or interpretation). Never a simulation id."
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "method_version": {
                "type": "string",
                "minLength": 1
              },
              "generated_by": {
                "const": "FlameGuard-SI"
              }
            }
          }
        },
        "required": [
          "limitations"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "curation_notes"
              ]
            },
            {
              "required": [
                "test_id"
              ]
            },
            {
              "required": [
                "test_outcome"
              ]
            }
          ]
        }
      }
    },
    {
      "description": "excluded: measured only, value null (via value_matches_status), and at least one exclusion note.",
      "if": {
        "required": [
          "value_status"
        ],
        "properties": {
          "value_status": {
            "const": "excluded"
          }
        }
      },
      "then": {
        "required": [
          "curation_notes"
        ],
        "properties": {
          "evidence_class": {
            "const": "measured"
          },
          "curation_notes": {
            "contains": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "exclusion"
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "An exclusion note means the value is excluded, so an excluded value can never stay numerically available.",
      "if": {
        "required": [
          "curation_notes"
        ],
        "properties": {
          "curation_notes": {
            "contains": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "exclusion"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "value_status": {
            "const": "excluded"
          }
        }
      }
    },
    {
      "description": "A reported test_outcome belongs to an identified test: it needs a non-null test_id.",
      "if": {
        "required": [
          "test_outcome"
        ],
        "properties": {
          "test_outcome": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "test_id"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          }
        }
      }
    }
  ]
}
