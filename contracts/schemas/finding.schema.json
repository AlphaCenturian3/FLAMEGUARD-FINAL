{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Finding",
  "description": "One NASA-measured value or one FlameGuard-SI interpretation. Simulations are NOT Findings; they use SimulationResult only.",
  "type": "object",
  "required": [
    "id",
    "investigation_id",
    "evidence_class",
    "statement",
    "quantity",
    "value",
    "unit",
    "value_status",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "fixture": {
      "type": "boolean"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "investigation_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "evidence_class": {
      "$ref": "common.schema.json#/$defs/non_simulation_class"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": [
        "string",
        "null"
      ],
      "description": "Key from contracts/vocabulary.json, or null for a qualitative statement."
    },
    "value": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "value_status": {
      "$ref": "common.schema.json#/$defs/value_status"
    },
    "uncertainty": {
      "$ref": "common.schema.json#/$defs/text_or_null",
      "description": "As reported by the source; never invented."
    },
    "conditions": {
      "$ref": "conditions.schema.json"
    },
    "fire_safety_topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "prevention",
          "detection",
          "suppression",
          "material_flammability",
          "ignition",
          "extinction",
          "other"
        ]
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/value_matches_status"
    },
    {
      "$ref": "quantity_rules.schema.json"
    },
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "measured"
          }
        }
      },
      "then": {
        "required": [
          "conditions"
        ],
        "properties": {
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manifest_id",
              "locator",
              "sources"
            ],
            "properties": {
              "manifest_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "description": "Where in the source: e.g. 'Table IX, row 3' or 'file.csv line 12'."
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "source.schema.json"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "interpretation"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "derived_from",
              "method",
              "method_version",
              "generated_by"
            ],
            "properties": {
              "derived_from": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "description": "Finding ids (measured or interpretation). Never a simulation id."
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "method_version": {
                "type": "string",
                "minLength": 1
              },
              "generated_by": {
                "const": "FlameGuard-SI"
              }
            }
          }
        }
      }
    }
  ]
}
