{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Finding",
  "description": "One value or statement with exactly one evidence class.",
  "type": "object",
  "required": ["id", "investigation_id", "evidence_class", "statement", "provenance"],
  "properties": {
    "fixture": {"type": "boolean"},
    "id": {"type": "string", "minLength": 1},
    "investigation_id": {"type": "string", "minLength": 1},
    "evidence_class": {"enum": ["measured", "interpretation", "illustrative_simulation"]},
    "statement": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "string", "null"]},
    "unit": {"type": ["string", "null"]},
    "uncertainty": {"type": ["string", "null"], "description": "As reported by the source; never invented."},
    "provenance": {"type": "object"},
    "label": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_class": {"const": "measured"}}},
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "required": ["manifest_id", "sources"],
            "properties": {
              "manifest_id": {"type": "string", "minLength": 1},
              "sources": {"type": "array", "minItems": 1, "items": {"$ref": "source.schema.json"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"evidence_class": {"const": "interpretation"}}},
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "required": ["derived_from", "method", "generated_by"],
            "properties": {
              "derived_from": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "method": {"type": "string", "minLength": 1},
              "generated_by": {"const": "FlameGuard-SI"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"evidence_class": {"const": "illustrative_simulation"}}},
      "then": {
        "required": ["label"],
        "properties": {
          "label": {"const": "Fluid and thermal transport model. No combustion chemistry."},
          "provenance": {
            "type": "object",
            "required": ["model", "model_version"]
          }
        }
      }
    }
  ]
}
