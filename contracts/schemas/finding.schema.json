{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Finding",
  "description": "One NASA-measured value or one FlameGuard-SI interpretation. Simulations are NOT Findings; they use SimulationResult only.",
  "type": "object",
  "required": ["id", "investigation_id", "evidence_class", "statement", "value_status", "provenance"],
  "properties": {
    "fixture": {"type": "boolean"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "investigation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "evidence_class": {"enum": ["measured", "interpretation"]},
    "statement": {"type": "string", "minLength": 1},
    "quantity": {"type": ["string", "null"], "description": "Key from contracts/vocabulary.json, or null for a qualitative statement."},
    "value": {"type": ["number", "string", "null"]},
    "unit": {"type": ["string", "null"], "description": "Must equal the vocabulary unit for the quantity."},
    "value_status": {"enum": ["reported", "not_reported", "not_applicable"]},
    "uncertainty": {"type": ["string", "null"], "description": "As reported by the source; never invented."},
    "conditions": {"$ref": "conditions.schema.json"},
    "fire_safety_topics": {
      "type": "array",
      "items": {"enum": ["prevention", "detection", "suppression", "material_flammability", "ignition", "extinction", "other"]}
    },
    "provenance": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"value_status": {"const": "reported"}}},
      "then": {"properties": {"value": {"type": ["number", "string"]}}}
    },
    {
      "if": {"properties": {"value_status": {"enum": ["not_reported", "not_applicable"]}}},
      "then": {"properties": {"value": {"type": "null"}}}
    },
    {
      "if": {"required": ["value"], "properties": {"value": {"type": "number"}}},
      "then": {"required": ["quantity", "unit"], "properties": {"quantity": {"type": "string"}, "unit": {"type": "string"}}}
    },
    {
      "if": {"properties": {"evidence_class": {"const": "measured"}}},
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "required": ["manifest_id", "locator", "sources"],
            "properties": {
              "manifest_id": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 1, "description": "Where in the source: e.g. 'Table IX, row 3' or 'file.csv line 12'."},
              "sources": {"type": "array", "minItems": 1, "items": {"$ref": "source.schema.json"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"evidence_class": {"const": "interpretation"}}},
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "required": ["derived_from", "method", "method_version", "generated_by"],
            "properties": {
              "derived_from": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Finding ids (measured or interpretation). Never a simulation id."},
              "method": {"type": "string", "minLength": 1},
              "method_version": {"type": "string", "minLength": 1},
              "generated_by": {"const": "FlameGuard-SI"}
            }
          }
        }
      }
    }
  ]
}
