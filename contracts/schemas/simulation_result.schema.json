{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simulation_result.schema.json",
  "title": "SimulationResult",
  "description": "Illustrative model output. Never experimental data; never a ranking or assistant input.",
  "type": "object",
  "required": ["id", "evidence_class", "label", "model", "model_version", "parameters", "outputs"],
  "properties": {
    "fixture": {"type": "boolean"},
    "id": {"type": "string", "minLength": 1},
    "evidence_class": {"const": "illustrative_simulation"},
    "label": {"const": "Fluid and thermal transport model. No combustion chemistry."},
    "model": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "verification_status": {"enum": ["unverified", "numerically_verified", "validated_against_measured"]},
    "parameters": {"type": "object"},
    "outputs": {"type": "object"}
  }
}
