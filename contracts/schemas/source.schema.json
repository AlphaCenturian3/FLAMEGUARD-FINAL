{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Source",
  "description": "A citation to a NASA or other primary source. Quotes must be exact.",
  "type": "object",
  "required": [
    "title",
    "url",
    "retrieved"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "$ref": "common.schema.json#/$defs/http_url"
    },
    "page": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "quote": {
      "$ref": "common.schema.json#/$defs/text_or_null",
      "description": "Exact text from the source; null if none."
    },
    "retrieved": {
      "$ref": "common.schema.json#/$defs/iso_date"
    },
    "archive_id": {
      "$ref": "common.schema.json#/$defs/text_or_null",
      "description": "PSI dataset ID, NTRS ID, etc."
    }
  }
}
