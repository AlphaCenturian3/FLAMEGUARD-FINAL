{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data_manifest.schema.json",
  "title": "DataManifest",
  "description": "Registry of every file in data/curated and data/simulated. Mirrors the rules in tools/check_data_provenance.py, which additionally checks files and hashes.",
  "type": "object",
  "required": [
    "manifest_version",
    "datasets"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "evidence_class",
          "sha256",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "path": {
            "type": "string",
            "pattern": "^data/(curated|simulated)/[^.][^\\s]*$"
          },
          "evidence_class": {
            "enum": [
              "measured",
              "interpretation",
              "illustrative_simulation"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "source.schema.json"
            }
          },
          "rights_status": {
            "enum": [
              "public_domain_confirmed",
              "permitted_with_citation",
              "under_review",
              "restricted"
            ]
          },
          "derived_from": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence_class": {
                  "const": "measured"
                }
              }
            },
            "then": {
              "required": [
                "sources",
                "rights_status"
              ],
              "properties": {
                "path": {
                  "pattern": "^data/curated/(?!interpretations/)"
                },
                "sources": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_class": {
                  "const": "interpretation"
                }
              }
            },
            "then": {
              "required": [
                "derived_from",
                "method"
              ],
              "properties": {
                "path": {
                  "pattern": "^data/curated/interpretations/"
                },
                "derived_from": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_class": {
                  "const": "illustrative_simulation"
                }
              }
            },
            "then": {
              "required": [
                "model",
                "model_version",
                "label"
              ],
              "properties": {
                "path": {
                  "pattern": "^data/simulated/"
                },
                "label": {
                  "const": "Fluid and thermal transport model. No combustion chemistry."
                }
              }
            }
          }
        ]
      }
    }
  }
}
