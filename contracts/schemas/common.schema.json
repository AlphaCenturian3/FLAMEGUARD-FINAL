{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common definitions",
  "description": "Shared definitions so every schema uses one copy of each rule.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "maxLength": 128
    },
    "non_simulation_class": {
      "enum": [
        "measured",
        "interpretation"
      ]
    },
    "value_status": {
      "enum": [
        "reported",
        "not_reported",
        "not_applicable",
        "withheld"
      ],
      "description": "reported: the source gives a value. not_reported: the source gives none. not_applicable: no value applies (qualitative statement). withheld: the source reports a value, but FlameGuard-SI excludes it from use after a reviewed quality flag; the value is null here and stays as printed in the source file the locator points to."
    },
    "environment": {
      "enum": [
        "spacecraft",
        "space_station",
        "lunar_base",
        "martian_base",
        "pressurized_rover",
        "earth"
      ]
    },
    "text_or_null": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "iso_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "http_url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "value_matches_status": {
      "description": "reported needs a non-null value; not_reported, not_applicable and withheld need null.",
      "allOf": [
        {
          "if": {
            "properties": {
              "value_status": {
                "const": "reported"
              }
            },
            "required": [
              "value_status"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_status": {
                "enum": [
                  "not_reported",
                  "not_applicable",
                  "withheld"
                ]
              }
            },
            "required": [
              "value_status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "curation_note": {
      "description": "A FlameGuard-SI quality assessment of a measured value. Never source text; source-reported uncertainty belongs in `uncertainty`.",
      "type": "object",
      "required": [
        "kind",
        "note",
        "generated_by"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "caution",
            "exclusion"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable reason."
        },
        "generated_by": {
          "const": "FlameGuard-SI"
        },
        "flag_ref": {
          "type": "object",
          "required": [
            "manifest_id",
            "flag_id"
          ],
          "additionalProperties": false,
          "description": "The reviewed quality-flag record behind this note (data/curated/interpretations/quality/).",
          "properties": {
            "manifest_id": {
              "$ref": "#/$defs/id"
            },
            "flag_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "exclusion"
          }
        }
      },
      "then": {
        "required": [
          "flag_ref"
        ]
      }
    }
  }
}
