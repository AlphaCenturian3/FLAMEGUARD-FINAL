{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common definitions",
  "description": "Shared definitions so every schema uses one copy of each rule.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "maxLength": 128
    },
    "non_simulation_class": {
      "enum": [
        "measured",
        "interpretation"
      ]
    },
    "value_status": {
      "description": "excluded: the source prints a value, but a FlameGuard-SI data-quality flag excludes it from quantitative use. The value is null here; the printed value stays only in the registered source file at the finding's locator.",
      "enum": [
        "reported",
        "not_reported",
        "not_applicable",
        "excluded"
      ]
    },
    "curation_note": {
      "description": "A FlameGuard-SI curation judgment about a measured value (decision C3, amended). Never source-reported uncertainty. Linked to the data-quality flag that records it and to the exact NASA passage it relies on.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "generated_by",
        "flag_ref",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "caution",
            "exclusion"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "generated_by": {
          "const": "FlameGuard-SI"
        },
        "flag_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_id",
            "flag_id"
          ],
          "properties": {
            "manifest_id": {
              "$ref": "#/$defs/id",
              "description": "Manifest id of the interpretation-class data-quality flags file."
            },
            "flag_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Row id within that flags file."
            }
          }
        },
        "source": {
          "description": "The NASA passage the note relies on. An exact quote is required.",
          "allOf": [
            {
              "$ref": "source.schema.json"
            },
            {
              "required": [
                "quote"
              ],
              "properties": {
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "environment": {
      "enum": [
        "spacecraft",
        "space_station",
        "lunar_base",
        "martian_base",
        "pressurized_rover",
        "earth"
      ]
    },
    "text_or_null": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "iso_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "http_url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "value_matches_status": {
      "description": "reported needs a non-null value; not_reported/not_applicable/excluded need null.",
      "allOf": [
        {
          "if": {
            "properties": {
              "value_status": {
                "const": "reported"
              }
            },
            "required": [
              "value_status"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_status": {
                "enum": [
                  "not_reported",
                  "not_applicable",
                  "excluded"
                ]
              }
            },
            "required": [
              "value_status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
