{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conditions.schema.json",
  "title": "Conditions",
  "description": "Experimental conditions as reported by the source. Units are fixed by key name. Every key is present; null means not reported. Never estimate a value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gravity_environment",
    "oxygen_mole_fraction",
    "pressure_kpa",
    "flow_velocity_mm_s",
    "flow_configuration",
    "diluent",
    "fuel_or_material",
    "sample_geometry"
  ],
  "properties": {
    "gravity_environment": {
      "enum": [
        "microgravity",
        "partial_gravity",
        "normal_gravity",
        null
      ]
    },
    "oxygen_mole_fraction": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "pressure_kpa": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "flow_velocity_mm_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "flow_configuration": {
      "enum": [
        "opposed",
        "concurrent",
        "quiescent",
        null
      ]
    },
    "diluent": {
      "$ref": "common.schema.json#/$defs/text_or_null"
    },
    "fuel_or_material": {
      "$ref": "common.schema.json#/$defs/text_or_null"
    },
    "sample_geometry": {
      "$ref": "common.schema.json#/$defs/text_or_null"
    }
  }
}
